# M2Y Browser GN overrides; appended after Cromite's build/cromite.gn_args, so later assignments win.

# own package, own name (strings are set by m2y/apply.sh)
chrome_public_manifest_package = "com.m2y.browser"

# the BYD head unit is the only target: arm64 built by the workflow, one density, three languages
# (locale and density trimming live in m2y/apply.sh because they are not GN args)
# Android always loads the default-gender locale pak (resource_bundle_android.cc: Gender::kDefault),
# so the empty _FEMININE/_MASCULINE/_NEUTER paks are never read
translate_genders = false

# PGO stays on (Cromite: chrome_pgo_phase = 2): the android-arm64 profile ships with the public orderfile package
# (chrome/android/orderfiles/arm64/pgo_profile.arm64.profdata); without it the native code was 12% larger

# No debug symbols or linker maps: nothing on the car uses them, and they cost hours and disk in the relay
symbol_level = 0
blink_symbol_level = 0
use_debug_fission = false # Cromite turns it on; it requires symbols
generate_linker_map = false

# A warning must not throw away a 30-hour build
treat_warnings_as_errors = false
fatal_linker_warnings = false

# no WebView is built for the car, keep the Chromium default package there
