#!/usr/bin/env bash
# M2Y Browser build configuration (sourced by build.sh and the workflows)

# ninja targets; build.sh resolves the --target name through these variables
chrome_modern_target=chrome_public_apk
webview_target=system_webview_apk
all=all

# Chromium tag = the tag Cromite's patch set is maintained for (build/RELEASE in the Cromite checkout)
chromium_version=153.0.8010.37
# Cromite commit whose patches are applied (release v153.0.8010.37-11507ac…)
cromite_commit=11507ac1061b5ea227806f5e84db5a57df6ccf6a
cromite_repo=https://github.com/uazo/cromite.git
# M2Y revision on top of that Chromium tag; bump when m2y/apply.sh or m2y.gn_args change
m2y_revision=5
